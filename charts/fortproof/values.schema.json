{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FortProof Helm values",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "settings", "secrets"],
  "properties": {
    "image": {
      "type": "object", "additionalProperties": false, "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["IfNotPresent", "Always", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "settings": {
      "type": "object",
      "description": "aap.yaml; validated against schemas/settings/aap.schema.json by the platform at start-up",
      "required": ["version", "env"],
      "properties": {
        "env": { "enum": ["development", "production"] },
        "secrets": { "type": "object", "properties": { "backend": { "const": "mounted" } } }
      }
    },
    "rules": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "files": {
          "type": "object",
          "description": "Your rules files by repository path (config/... or catalogue/...), as text; the rest are the image's defaults",
          "propertyNames": { "pattern": "^(config|catalogue)/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*\\.(yaml|yml|json|jsonl)$" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "secrets": {
      "type": "object", "additionalProperties": false, "required": ["existingSecret", "keys"],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "keys": {
          "type": "object", "additionalProperties": false, "required": ["api", "hook", "worker", "migrate"],
          "properties": {
            "api": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "contains": { "const": "database-url-api" } },
            "hook": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "contains": { "const": "database-url-hook" } },
            "worker": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "contains": { "const": "database-url-worker" } },
            "migrate": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "contains": { "const": "database-url" } }
          }
        }
      }
    },
    "serviceAccount": { "type": "object", "properties": { "create": { "type": "boolean" }, "annotations": { "type": "object" } } },
    "api": { "$ref": "#/$defs/process" },
    "hook": { "allOf": [{ "$ref": "#/$defs/process" }, { "properties": { "enabled": { "type": "boolean" } } }] },
    "worker": { "$ref": "#/$defs/process" },
    "migrate": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "activeDeadlineSeconds": { "type": "integer", "minimum": 60 } } },
    "ingress": { "type": "object" },
    "podDisruptionBudget": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "minAvailable": { "type": ["integer", "string"] } } },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFromNamespaceLabels": { "type": "object" },
        "postgres": { "type": "object", "required": ["cidr", "port"], "properties": { "cidr": { "type": "string" }, "port": { "type": "integer" } } },
        "egressHttpsCIDRs": { "type": "array", "items": { "type": "string" } },
        "egressHttpsExcept": { "type": "array", "items": { "type": "string" } }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": { "runAsNonRoot": { "const": true } },
      "description": "the platform never runs as root"
    },
    "securityContext": {
      "type": "object",
      "properties": { "allowPrivilegeEscalation": { "const": false }, "readOnlyRootFilesystem": { "const": true } }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  },
  "$defs": {
    "process": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "resources": { "type": "object" },
        "autoscaling": { "type": "object" },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
